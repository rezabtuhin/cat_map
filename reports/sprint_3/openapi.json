{
  "openapi": "3.1.0",
  "info": {
    "title": "Category Matcher Development API",
    "description": "Local development API. Only accepted matches assign a category.",
    "version": "0.3.0"
  },
  "paths": {
    "/health/live": {
      "get": {
        "summary": "Live",
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "summary": "Ready",
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/v1/taxonomies": {
      "get": {
        "summary": "Taxonomies",
        "operationId": "taxonomies_v1_taxonomies_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/TaxonomyInfo"
                  },
                  "type": "array",
                  "title": "Response Taxonomies V1 Taxonomies Get"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/taxonomies/{taxonomy_key}/categories/{category_id}": {
      "get": {
        "summary": "Canonical",
        "operationId": "canonical_v1_taxonomies__taxonomy_key__categories__category_id__get",
        "parameters": [
          {
            "name": "taxonomy_key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Taxonomy Key"
            }
          },
          {
            "name": "category_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Category Id"
            }
          },
          {
            "name": "taxonomy_version",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                {
                  "type": "null"
                }
              ],
              "title": "Taxonomy Version"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CategoryResponse"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        }
      }
    },
    "/v1/categories/match": {
      "post": {
        "summary": "Match",
        "operationId": "match_v1_categories_match_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MatchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MatchResponse"
                }
              }
            }
          },
          "413": {
            "description": "Request Entity Too Large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "415": {
            "description": "Unsupported Media Type",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "504": {
            "description": "Gateway Timeout",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CanonicalCategory": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "path": {
            "type": "string",
            "title": "Path"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "label",
          "path"
        ],
        "title": "CanonicalCategory"
      },
      "CategoryResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "path": {
            "type": "string",
            "title": "Path"
          },
          "taxonomy_key": {
            "type": "string",
            "const": "google",
            "title": "Taxonomy Key"
          },
          "taxonomy_version": {
            "type": "string",
            "title": "Taxonomy Version"
          },
          "artifact_version": {
            "type": "string",
            "title": "Artifact Version"
          },
          "parent_category_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parent Category Id"
          },
          "depth": {
            "type": "integer",
            "title": "Depth"
          },
          "is_leaf": {
            "type": "boolean",
            "title": "Is Leaf"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "label",
          "path",
          "taxonomy_key",
          "taxonomy_version",
          "artifact_version",
          "parent_category_id",
          "depth",
          "is_leaf"
        ],
        "title": "CategoryResponse"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "details": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          },
          "event_id": {
            "type": "string",
            "title": "Event Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "error",
          "event_id"
        ],
        "title": "ErrorResponse"
      },
      "MatchRequest": {
        "properties": {
          "taxonomy_key": {
            "type": "string",
            "const": "google",
            "title": "Taxonomy Key"
          },
          "taxonomy_version": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Taxonomy Version"
          },
          "category": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 300
              },
              {
                "type": "null"
              }
            ],
            "title": "Category"
          },
          "category_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Category Id"
          },
          "parent_category_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Parent Category Id"
          },
          "context": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1000
              },
              {
                "type": "null"
              }
            ],
            "title": "Context"
          },
          "language": {
            "type": "string",
            "maxLength": 32,
            "minLength": 2,
            "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$",
            "title": "Language",
            "default": "en"
          },
          "limit": {
            "type": "integer",
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Limit",
            "default": 3
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "taxonomy_key"
        ],
        "title": "MatchRequest"
      },
      "MatchResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "matched",
              "provisional",
              "needs_clarification",
              "no_match",
              "unsupported_language"
            ],
            "title": "Status"
          },
          "taxonomy_key": {
            "type": "string",
            "const": "google",
            "title": "Taxonomy Key"
          },
          "taxonomy_version": {
            "type": "string",
            "title": "Taxonomy Version"
          },
          "artifact_version": {
            "type": "string",
            "title": "Artifact Version"
          },
          "category": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CanonicalCategory"
              },
              {
                "type": "null"
              }
            ]
          },
          "alternatives": {
            "items": {
              "$ref": "#/components/schemas/CanonicalCategory"
            },
            "type": "array",
            "title": "Alternatives"
          },
          "method": {
            "type": "string",
            "title": "Method"
          },
          "reason_code": {
            "type": "string",
            "title": "Reason Code"
          },
          "clarification": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Clarification"
          },
          "event_id": {
            "type": "string",
            "title": "Event Id"
          },
          "timings": {
            "$ref": "#/components/schemas/Timings"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "taxonomy_key",
          "taxonomy_version",
          "artifact_version",
          "category",
          "alternatives",
          "method",
          "reason_code",
          "clarification",
          "event_id",
          "timings"
        ],
        "title": "MatchResponse"
      },
      "TaxonomyInfo": {
        "properties": {
          "taxonomy_key": {
            "type": "string",
            "const": "google",
            "title": "Taxonomy Key"
          },
          "taxonomy_version": {
            "type": "string",
            "title": "Taxonomy Version"
          },
          "artifact_version": {
            "type": "string",
            "title": "Artifact Version"
          },
          "languages": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Languages"
          },
          "category_count": {
            "type": "integer",
            "title": "Category Count"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "taxonomy_key",
          "taxonomy_version",
          "artifact_version",
          "languages",
          "category_count"
        ],
        "title": "TaxonomyInfo"
      },
      "Timings": {
        "properties": {
          "queue_wait_ms": {
            "type": "number",
            "minimum": 0.0,
            "title": "Queue Wait Ms"
          },
          "inference_ms": {
            "type": "number",
            "minimum": 0.0,
            "title": "Inference Ms"
          },
          "total_ms": {
            "type": "number",
            "minimum": 0.0,
            "title": "Total Ms"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "queue_wait_ms",
          "inference_ms",
          "total_ms"
        ],
        "title": "Timings"
      }
    }
  }
}
